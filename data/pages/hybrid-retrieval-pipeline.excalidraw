    {
      "id": "Qo2z7xonIBWOAQo9kNaU_",
      "type": "text",
      "x": -3709.8366280357086,
      "y": 9888.252686271728,
      "width": 952.3514537975277,
      "height": 1125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
