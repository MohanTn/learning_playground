      "backgroundColor": "#e0e7ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      },
      "version": 1586,
      "versionNonce": 1390770919,
      "index": "b46",
      "isDeleted": true,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1310410415,
