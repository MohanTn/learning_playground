      "boundElements": [],
      "updated": 1785877248487,
      "link": null,
      "locked": false,
      "text": "Step 2: Calculate Root Mean Square (RMS)\nMean = Sum / 4096\nRMS = √(Mean + 1e-5)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "-lyoWhMkl11xBg5U-JjBO",
      "originalText": "Step 2: Calculate Root Mean Square (RMS)\nMean = Sum / 4096\nRMS = √(Mean + 1e-5)",
      "autoResize": true,
      "lineHeight": 1.25
    },
