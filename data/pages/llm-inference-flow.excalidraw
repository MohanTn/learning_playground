    {
      "id": "_YUY9_33oESHYgAly83C7",
      "type": "text",
      "x": 3546.2071501204173,
      "y": 8943.450099756496,
      "width": 1104,
      "height": 1200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b63",
      "roundness": null,
      "seed": 1770279170,
      "version": 1316,
      "versionNonce": 1110144583,
