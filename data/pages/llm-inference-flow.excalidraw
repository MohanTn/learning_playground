      "text": "Keys_K = [\n    [ -0.1245,  0.9851, -0.4412,  0.1102 ], # Token 0 Key Vector\n    [  0.8912, -0.2234,  1.1090, -0.6541 ], # Token 1 Key Vector\n    [  0.3145,  0.4452, -0.0125,  0.8841 ]  # Token 2 Key Vector\n]",
