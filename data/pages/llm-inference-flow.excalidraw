    {
      "id": "gx_kGqGrWSx4blumgeGIh",
      "type": "text",
      "x": -6377.57942988059,
      "y": 8835.120774169483,
      "width": 446,
      "height": 105,
      "angle": 0,
      "strokeColor": "#115e59",
      "text": "STEP 3: CAUSAL MASK -> SOFTMAX (Probabilities)\nSet every future position to -inf FIRST, then Softmax per row:\n[ 1.0000,  0.0000,  0.0000 ] -> T0 can only see T0\n[ 0.3115,  0.6885,  0.0000 ] -> T1 sees T0 + itself\n[ 0.2109,  0.4584,  0.3306 ] -> T2 sees all three\nLower-triangular: each row still sums to 1.0, but nothing sits\nabove the diagonal. A token never attends to the future.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "version": 1577,
      "versionNonce": 1521445816,
      "index": "b42",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "backgroundColor": "transparent",
      "seed": 1474516527,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "iL0b0_Yp4MkXLoXFSSQ88",
          "type": "arrow"
        }
      ],
      "updated": 1785876468302,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STEP 3: CAUSAL MASK -> SOFTMAX (Probabilities)\nSet every future position to -inf FIRST, then Softmax per row:\n[ 1.0000,  0.0000,  0.0000 ] -> T0 can only see T0\n[ 0.3115,  0.6885,  0.0000 ] -> T1 sees T0 + itself\n[ 0.2109,  0.4584,  0.3306 ] -> T2 sees all three\nLower-triangular: each row still sums to 1.0, but nothing sits\nabove the diagonal. A token never attends to the future.",
      "autoResize": true,
      "lineHeight": 1.6666666666666667
    },
