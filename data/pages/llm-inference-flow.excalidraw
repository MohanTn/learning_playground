    {
      "id": "vkp0uKUMeKUqSs1et0yIl",
      "type": "text",
      "x": -7129.058096396753,
      "y": 8713.849386673273,
      "width": 640,
      "height": 175,
      "angle": 0,
      "strokeColor": "#f08c00",
