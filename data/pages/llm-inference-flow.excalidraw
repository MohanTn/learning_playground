    {
      "id": "qL0uWlF_yr5cmCPzaJ11y",
      "type": "text",
      "x": -2963.226909811039,
      "y": 4523.003635071498,
      "width": 667.95947265625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
