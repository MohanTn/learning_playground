    {
      "id": "OdssyXG_WJ_dn_jOEJPUv",
      "type": "text",
      "x": 2254.3572261945847,
      "y": -335.08294935640834,
      "width": 840,
      "height": 690,
      "angle": 0,
      "strokeColor": "#1e1e1e",
