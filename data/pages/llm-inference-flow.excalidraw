      ],
      "updated": 1785872415980,
      "link": null,
      "locked": false,
      "text": "◄───────────────── Hidden Dimension (4096) ─────────────────►\n               ┌───────────────────────────────────────────────────────────────┐\n   Token 1 ───►│ [ 0.12, -0.45,  0.89, ... ] ──► Calculates its own RMS₁ ──────┼──► Scaled Line 1\n   Token 2 ───►│ [ 0.12, -0.45,  0.89, ... ] ──► Calculates its own RMS₂ ──────┼──► Scaled Line 2\n     │         │                                                               │\n    1000      │                           ...                                 │\n   Tokens    │                                                               │\n     │         │                                                               │\n Last Token───►│ [ 0.12, -0.45,  0.89, ... ] ──► Calculates its own RMS₁₀₀₀ ───┼──► Scaled Line 1000\n               └───────────────────────────────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "◄───────────────── Hidden Dimension (4096) ─────────────────►\n               ┌───────────────────────────────────────────────────────────────┐\n   Token 1 ───►│ [ 0.12, -0.45,  0.89, ... ] ──► Calculates its own RMS₁ ──────┼──► Scaled Line 1\n   Token 2 ───►│ [ 0.12, -0.45,  0.89, ... ] ──► Calculates its own RMS₂ ──────┼──► Scaled Line 2\n     │         │                                                               │\n    1000      │                           ...                                 │\n   Tokens    │                                                               │\n     │         │                                                               │\n Last Token───►│ [ 0.12, -0.45,  0.89, ... ] ──► Calculates its own RMS₁₀₀₀ ───┼──► Scaled Line 1000\n               └───────────────────────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
