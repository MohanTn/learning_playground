      "text": "{\n  \"routes\": [\n    {\n      \"keywords\": [\"api\", \"endpoint\", \"post\", \"get\", \"/v2\"],\n      \"file\": \"diagrams/api/overview.mmd\",\n      \"priority\": 10\n    },\n    {\n      \"keywords\": [\"ui\", \"component\", \"frontend\", \"react\", \"state\"],\n      \"file\": \"diagrams/ui/component_tree.mmd\",\n      \"priority\": 9\n    },\n    {\n      \"keywords\": [\"segfault\", \"core dumped\", \"docker\", \"build failed\"],\n      \"file\": \"diagrams/debug/playbook.mmd\",\n      \"priority\": 10\n    },\n    {\n      \"keywords\": [\"refactor\", \"rename\", \"move\", \"dependency\"],\n      \"file\": \"diagrams/refactor/dependency_graph.mmd\",\n      \"priority\": 8\n    },\n    {\n      \"keywords\": [\"test\", \"spec\", \"bazel\", \"pytest\"],\n      \"file\": \"diagrams/test/suite.mmd\",\n      \"priority\": 9\n    }\n  ]\n}",
      "fontSize": 36,
