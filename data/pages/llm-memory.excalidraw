    {
      "id": "NuXn3Oykd07E_UWs-IKjy",
      "type": "text",
      "x": -1084.7693248562275,
      "y": 6980.101705673683,
      "width": 1122.538818359375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
