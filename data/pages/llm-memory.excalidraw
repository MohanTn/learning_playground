    {
      "id": "YaTxIfNz39aDMS1emRVlG",
      "type": "text",
      "x": 1754.3565403226905,
      "y": 15465.136907905635,
      "width": 924.9920772955853,
      "height": 1680,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7J",
      "roundness": null,
      "seed": 570814121,
      "version": 778,
      "versionNonce": 2020032254,
      "isDeleted": true,
      "boundElements": [
