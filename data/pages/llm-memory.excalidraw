    {
      "id": "jIRT8aNzARzP-Wmk_JbOO",
      "type": "text",
      "x": -7200.213576778193,
      "y": 9084.456058316586,
      "width": 679.3994140625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#0d9488",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
