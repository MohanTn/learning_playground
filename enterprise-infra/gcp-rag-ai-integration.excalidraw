      "updated": 1788108898195,
      "link": null,
      "locked": false,
      "text": "Threshold Derivation -\ntau per field\nfalse accept = wrong\ninvoice + dispute (~EUR\n120)false reject =\nreviewer minutes (~EUR\n0.40)\nratio sets tolerable error\nrate\nthen CLAMPED to review\ncapacity",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "7eFbHcXsDZEDRTYfGlNep",
      "originalText": "Threshold Derivation - tau per field\nfalse accept = wrong invoice + dispute (~EUR 120)false reject = reviewer minutes (~EUR 0.40)\nratio sets tolerable error rate\nthen CLAMPED to review capacity",
      "autoResize": true,
      "lineHeight": 1.25
    },
