      "link": null,
      "locked": false,
      "text": "DDoS and SYN Flood Protection",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "XSn_I4WTZTf9UjTsSEIQh",
      "originalText": "DDoS and SYN Flood Protection",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rd9IDhrGa8zQ3gNnd2Bbe",
      "type": "text",
      "x": 6885.340841387474,
      "y": 250.97899762830548,
      "width": 463.1595458984375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMD",
      "roundness": null,
      "seed": 1464818734,
      "version": 480,
      "versionNonce": 967310907,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "1u-sXnm1dCzKxYTY0Gy6E",
          "type": "arrow"
        }
      ],
      "updated": 1787919407960,
      "link": null,
      "locked": false,
      "text": "The GLB inspects the TCP handshake rate. If\nParis suddenly sends 10,000 requests/sec\n(malicious or broken EMR), the GLB's built-in\nWAF triggers a rate-limit at the edge, returning\n429 before waking up our API Gateway.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GLB inspects the TCP handshake rate. If Paris suddenly sends 10,000 requests/sec (malicious or broken EMR), the GLB's built-in WAF triggers a rate-limit at the edge, returning 429 before waking up our API Gateway.",
      "autoResize": false,
      "lineHeight": 1.25
    },
