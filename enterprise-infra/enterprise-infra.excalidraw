    {
      "id": "1a_mG4jy1Rx6ZxSkTdS7O",
      "type": "text",
      "x": 619.4999904234987,
      "y": 367.1409249530554,
      "width": 436.1995849609375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGR",
      "roundness": null,
      "seed": 879345774,
      "version": 279,
      "versionNonce": 246782715,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402636,
      "link": null,
      "locked": false,
      "text": "The GLB removes the external client IP (to\nprevent exposing it to downstream logs) and\ninjects standard X-Forwarded-For and X-\nForwarded-Proto headers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GLB removes the external client IP (to prevent exposing it to downstream logs) and injects standard X-Forwarded-For and X-Forwarded-Proto headers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
