    {
      "id": "kmtzm-EUJT4WJjunsaQuJ",
      "type": "text",
      "x": -837.4291945086056,
      "y": -55.07562301447251,
      "width": 756.8709106445312,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
