      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "downloads the IdP's Public Key (JWKS) and caches it\nlocally in Redis.\nThis internal call happens once every hour (or when the\nkey rotates), not per API request.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "mRuM-W_R338mE6pSiXhEN",
      "originalText": "downloads the IdP's Public Key (JWKS) and caches it locally in Redis.\nThis internal call happens once every hour (or when the key rotates), not per API request.",
      "autoResize": true,
      "lineHeight": 1.25
    },
