    },
    {
      "id": "wUzqW_mQd7j3Rk5mC_kSH",
      "type": "text",
      "x": -1772.231136660916,
      "y": 20.84891770655713,
      "width": 385.9249562132507,
      "height": 26.517380955772833,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "puo72rl7GWFY7OXBgVUsb"
      ],
      "frameId": null,
      "index": "bKR",
      "roundness": null,
      "seed": 189180782,
      "version": 296,
      "versionNonce": 1050135733,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "EMR fetches JWT (Internet to IdP)",
      "fontSize": 21.213904764618267,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EMR fetches JWT (Internet to IdP)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EXbyR1zIf784cSv8A7DiD",
      "type": "text",
      "x": -1876.9009881786753,
      "y": 75.77777825780083,
      "width": 595.2646592487703,
      "height": 53.034761911545665,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "puo72rl7GWFY7OXBgVUsb"
      ],
      "frameId": null,
      "index": "bKS",
      "roundness": null,
      "seed": 845056626,
      "version": 296,
      "versionNonce": 1897940251,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "Wait—If the IdP has no public IP, how does the Hamburg\nEMR fetch the JWT in Step 4?",
      "fontSize": 21.21390476461827,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wait—If the IdP has no public IP, how does the Hamburg EMR fetch the JWT in Step 4?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "SirTOVDqge1PeAz5-vyF0",
      "type": "text",
      "x": -1881.8756329385094,
      "y": 130.7066388090446,
      "width": 605.2139487684382,
      "height": 132.58690477886418,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "puo72rl7GWFY7OXBgVUsb"
      ],
      "frameId": null,
      "index": "bKT",
      "roundness": null,
      "seed": 276499886,
      "version": 296,
      "versionNonce": 1673948693,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "Solution: We expose a specific, heavily locked-down public\nendpoint for Token Issuance only. This is typically a\nseparate microservice sitting in the DMZ that proxies the\nrequest to the internal IdP, or we use an AWS PrivateLink\n/ Azure Private Endpoint.",
      "fontSize": 21.213904764618267,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solution: We expose a specific, heavily locked-down public endpoint for Token Issuance only. This is typically a separate microservice sitting in the DMZ that proxies the request to the internal IdP, or we use an AWS PrivateLink / Azure Private Endpoint.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "82m3_v4J8sax11xLUA8M8",
      "type": "text",
      "x": -1878.004106417201,
      "y": 304.96371366126607,
      "width": 597.4708957258209,
      "height": 132.58690477886418,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "puo72rl7GWFY7OXBgVUsb"
      ],
      "frameId": null,
      "index": "bKU",
      "roundness": null,
      "seed": 315124786,
      "version": 296,
      "versionNonce": 1957620155,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "Enterprise Best Practice: The EMR connects to\nauth.health-cloud.de/token (public DNS). The GLB routes\nthis specific path /token internally to the IdP service on\n10.0.10.5. The GLB does NOT validate JWT here; it just\nproxies the mTLS handshake.",
      "fontSize": 21.21390476461827,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Enterprise Best Practice: The EMR connects to auth.health-cloud.de/token (public DNS). The GLB routes this specific path /token internally to the IdP service on 10.0.10.5. The GLB does NOT validate JWT here; it just proxies the mTLS handshake.",
      "autoResize": false,
      "lineHeight": 1.25
    },
