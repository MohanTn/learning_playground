    {
      "id": "oEuY8IPKnfgzxa8PxVz-9",
      "type": "text",
      "x": -2048.667937980519,
      "y": -4248.897378891348,
      "width": 461.01959228515625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHE",
      "roundness": null,
      "seed": 1520877038,
      "version": 208,
      "versionNonce": 774187131,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919412744,
      "link": null,
      "locked": false,
      "text": "The Clinic creates a Key Pair: The IT admin at\nthe Hamburg clinic runs a software tool\n(OpenSSL) on their EMR server. This creates\ntwo mathematically linked files:\n\nPrivate Key (THE SECRET): Kept hidden deep\ninside the EMR server. Never shared with\nanyone. It's like the microchip under your\npassport's cover.\n\nPublic Key (The Lock): This can be shared\nfreely. It's like the passport number—useless\non its own, but essential for verification.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "XMSNgC_szrYFFyNxjMKAY",
      "originalText": "The Clinic creates a Key Pair: The IT admin at the Hamburg clinic runs a software tool (OpenSSL) on their EMR server. This creates two mathematically linked files:\n\nPrivate Key (THE SECRET): Kept hidden deep inside the EMR server. Never shared with anyone. It's like the microchip under your passport's cover.\n\nPublic Key (The Lock): This can be shared freely. It's like the passport number—useless on its own, but essential for verification.",
      "autoResize": true,
      "lineHeight": 1.25
    },
