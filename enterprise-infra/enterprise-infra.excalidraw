      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "H9xKDFIQD0nS-OoBZuTh8"
      ],
      "frameId": null,
      "index": "bLX",
      "roundness": null,
      "seed": 525514158,
      "version": 419,
      "versionNonce": 1046848693,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "Wait—If the IdP has no public IP, how does the Hamburg\nEMR fetch the JWT in Step 4?",
      "fontSize": 21.21390476461827,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wait—If the IdP has no public IP, how does the Hamburg EMR fetch the JWT in Step 4?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "1t45SdpOOPqgidUfs3gur",
      "type": "text",
      "x": -7290.778887405387,
      "y": 147.48313715582617,
      "width": 605.2139487684382,
      "height": 132.58690477886418,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "H9xKDFIQD0nS-OoBZuTh8"
      ],
      "frameId": null,
      "index": "bLY",
      "roundness": null,
      "seed": 1393283054,
      "version": 419,
      "versionNonce": 2143022363,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "Solution: We expose a specific, heavily locked-down public\nendpoint for Token Issuance only. This is typically a\nseparate microservice sitting in the DMZ that proxies the\nrequest to the internal IdP, or we use an AWS PrivateLink\n/ Azure Private Endpoint.",
      "fontSize": 21.213904764618267,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solution: We expose a specific, heavily locked-down public endpoint for Token Issuance only. This is typically a separate microservice sitting in the DMZ that proxies the request to the internal IdP, or we use an AWS PrivateLink / Azure Private Endpoint.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Kh3GVV1MM9xnL7ZIJt7xp",
      "type": "text",
      "x": -7286.907360884079,
      "y": 321.7402120080477,
      "width": 597.4708957258209,
      "height": 132.58690477886418,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "H9xKDFIQD0nS-OoBZuTh8"
      ],
      "frameId": null,
      "index": "bLZ",
      "roundness": null,
      "seed": 1562878510,
      "version": 419,
      "versionNonce": 1545160213,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "Enterprise Best Practice: The EMR connects to\nauth.health-cloud.de/token (public DNS). The GLB routes\nthis specific path /token internally to the IdP service on\n10.0.10.5. The GLB does NOT validate JWT here; it just\nproxies the mTLS handshake.",
      "fontSize": 21.21390476461827,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Enterprise Best Practice: The EMR connects to auth.health-cloud.de/token (public DNS). The GLB routes this specific path /token internally to the IdP service on 10.0.10.5. The GLB does NOT validate JWT here; it just proxies the mTLS handshake.",
      "autoResize": false,
      "lineHeight": 1.25
    },
