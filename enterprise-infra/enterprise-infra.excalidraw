    {
      "id": "7rYGg-fBkD_lj_K1knI9O",
      "type": "text",
      "x": -1844.5149464670299,
      "y": -777.9650469275905,
      "width": 671.8193359375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHL",
      "roundness": null,
      "seed": 1944272434,
      "version": 70,
      "versionNonce": 1985313691,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919412744,
      "link": null,
      "locked": false,
      "text": "The CA validates and signs: The CA does background checks to\nensure the clinic really exists. Once verified, the CA takes their\npowerful Private Key and digitally \"stamps\" the clinic's Public Key and\ndetails.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Y8CerHE7CvyEprVZ9R48X",
      "originalText": "The CA validates and signs: The CA does background checks to ensure the clinic really exists. Once verified, the CA takes their powerful Private Key and digitally \"stamps\" the clinic's Public Key and details.",
      "autoResize": true,
      "lineHeight": 1.25
    },
