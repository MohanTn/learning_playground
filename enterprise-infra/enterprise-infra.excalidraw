    },
    {
      "id": "49ztY3lE_zKSupVOAnSeP",
      "type": "text",
      "x": -4789.403264043379,
      "y": 383.917423299837,
      "width": 436.1995849609375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKm",
      "roundness": null,
      "seed": 1125753838,
      "version": 401,
      "versionNonce": 1264798107,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "jfL1DtOkg0lLgLyqznA71",
          "type": "arrow"
        }
      ],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "The GLB removes the external client IP (to\nprevent exposing it to downstream logs) and\ninjects standard X-Forwarded-For and X-\nForwarded-Proto headers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GLB removes the external client IP (to prevent exposing it to downstream logs) and injects standard X-Forwarded-For and X-Forwarded-Proto headers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
