      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919412744,
      "link": null,
      "locked": false,
      "text": "The Clinic creates a \"CSR\"\n(Certificate Signing Request): The\nadmin bundles their Public Key\ntogether with their official\nbusiness details (\"Clinic: Hamburg\nPractice, Location: Germany,\nDomain: emr.hamburg-practice.de\")\nand sends",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "nc62MG_DnvH1NuCRBUy8U",
      "originalText": "The Clinic creates a \"CSR\" (Certificate Signing Request): The admin bundles their Public Key together with their official business details (\"Clinic: Hamburg Practice, Location: Germany, Domain: emr.hamburg-practice.de\") and sends",
      "autoResize": true,
      "lineHeight": 1.25
    },
