      "text": "Stripping External Layer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "zmwCE_C7SrJGVY0kVQXQI",
      "originalText": "Stripping External Layer",
      "autoResize": true,
