      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u09EnZg_DQjmoglgGaH1i",
      "type": "text",
      "x": 4500.53394957718,
      "y": 92.74376808205739,
      "width": 385.9249562132507,
      "height": 26.517380955772833,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aFWAxIVfEthGKMZ68_KmO"
      ],
      "frameId": null,
      "index": "bN1",
      "roundness": null,
      "seed": 1945785518,
      "version": 548,
      "versionNonce": 443864795,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402637,
      "link": null,
      "locked": false,
      "text": "EMR fetches JWT (Internet to IdP)",
      "fontSize": 21.213904764618267,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EMR fetches JWT (Internet to IdP)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CKT0C4sle18kMGhXn-qj9",
      "type": "text",
      "x": 4395.86409805942,
      "y": 147.6726286333011,
      "width": 595.2646592487703,
      "height": 53.034761911545665,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aFWAxIVfEthGKMZ68_KmO"
      ],
      "frameId": null,
      "index": "bN2",
      "roundness": null,
      "seed": 258445038,
      "version": 548,
      "versionNonce": 353163349,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402637,
      "link": null,
      "locked": false,
      "text": "Wait—If the IdP has no public IP, how does the Hamburg\nEMR fetch the JWT in Step 4?",
      "fontSize": 21.21390476461827,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wait—If the IdP has no public IP, how does the Hamburg EMR fetch the JWT in Step 4?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "2mCpzXdywtu4rYhWOWcgL",
      "type": "text",
      "x": 4390.8894532995855,
      "y": 202.6014891845448,
      "width": 605.2139487684382,
      "height": 132.58690477886418,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aFWAxIVfEthGKMZ68_KmO"
      ],
      "frameId": null,
      "index": "bN3",
      "roundness": null,
      "seed": 900956462,
      "version": 548,
      "versionNonce": 822821755,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402637,
      "link": null,
      "locked": false,
      "text": "Solution: We expose a specific, heavily locked-down public\nendpoint for Token Issuance only. This is typically a\nseparate microservice sitting in the DMZ that proxies the\nrequest to the internal IdP, or we use an AWS PrivateLink\n/ Azure Private Endpoint.",
      "fontSize": 21.213904764618267,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solution: We expose a specific, heavily locked-down public endpoint for Token Issuance only. This is typically a separate microservice sitting in the DMZ that proxies the request to the internal IdP, or we use an AWS PrivateLink / Azure Private Endpoint.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "SRGGKWArNg5vzEArQxG0r",
      "type": "text",
      "x": 4394.760979820894,
      "y": 376.8585640367663,
      "width": 597.4708957258209,
      "height": 132.58690477886418,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aFWAxIVfEthGKMZ68_KmO"
      ],
      "frameId": null,
      "index": "bN4",
      "roundness": null,
      "seed": 172436334,
      "version": 548,
      "versionNonce": 718865845,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402637,
      "link": null,
      "locked": false,
      "text": "Enterprise Best Practice: The EMR connects to\nauth.health-cloud.de/token (public DNS). The GLB routes\nthis specific path /token internally to the IdP service on\n10.0.10.5. The GLB does NOT validate JWT here; it just\nproxies the mTLS handshake.",
      "fontSize": 21.21390476461827,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Enterprise Best Practice: The EMR connects to auth.health-cloud.de/token (public DNS). The GLB routes this specific path /token internally to the IdP service on 10.0.10.5. The GLB does NOT validate JWT here; it just proxies the mTLS handshake.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "52z2oTBhidx77aj4sbaN5",
      "type": "diamond",
      "x": 6059.525809496243,
      "y": 606.8943084070443,
      "width": 112.64736525303451,
      "height": 36.77344700318558,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fd8888",
