    {
      "id": "uWj5XJ545d4ZRnWkbq_oT",
      "type": "text",
      "x": 576.4291391933599,
      "y": 1670.6539442327958,
      "width": 777.0962524414062,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bO0",
      "roundness": null,
      "seed": 336202523,
      "version": 78,
      "versionNonce": 1750566357,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402637,
      "link": null,
      "locked": false,
      "text": "Reverse Proxy & Routing: Directs incoming HTTP/HTTPS traffic to specific backend GKE services\nbased on hostnames (e.g., ://company.com) or URL paths (e.g., /v1/users).SSL/TLS Termination:\nDecrypts incoming HTTPS requests at the edge, relieving internal application pods from the CPU\noverhead of managing cryptographic handshakes.Centralized Security: Implements Web Application\nFirewall (WAF) rules, DDoS mitigation, IP whitelisting/blacklisting, and CORS policies.Traffic\nControl: Manages rate limiting to prevent API abuse, configures connection timeouts, and handles\ncustom error pages (e.g., 404, 503).Authentication Delegation: Validates JSON Web Tokens (JWTs)\nor integrates with OAuth2/OIDC providers before passing requests deeper into the cluster.Load\nBalancing & Canary Deployments: Distributes traffic across backend pod replicas using algorithms\nlike round-robin or least-connections, and splits traffic for blue-green or canary releases.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reverse Proxy & Routing: Directs incoming HTTP/HTTPS traffic to specific backend GKE services based on hostnames (e.g., ://company.com) or URL paths (e.g., /v1/users).SSL/TLS Termination: Decrypts incoming HTTPS requests at the edge, relieving internal application pods from the CPU overhead of managing cryptographic handshakes.Centralized Security: Implements Web Application Firewall (WAF) rules, DDoS mitigation, IP whitelisting/blacklisting, and CORS policies.Traffic Control: Manages rate limiting to prevent API abuse, configures connection timeouts, and handles custom error pages (e.g., 404, 503).Authentication Delegation: Validates JSON Web Tokens (JWTs) or integrates with OAuth2/OIDC providers before passing requests deeper into the cluster.Load Balancing & Canary Deployments: Distributes traffic across backend pod replicas using algorithms like round-robin or least-connections, and splits traffic for blue-green or canary releases.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "eBabICtRD_t09ckBxK-GM",
