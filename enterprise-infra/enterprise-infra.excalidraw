      "seed": 1075597614,
      "version": 34,
      "versionNonce": 1572951221,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402637,
      "link": null,
      "locked": false,
      "text": "Healthy: HTTP 200 OK with body {\"status\": \"UP\", \"components\": {\"gateway\":\"UP\",\n\"kafka\":\"UP\"}}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Healthy: HTTP 200 OK with body {\"status\": \"UP\", \"components\": {\"gateway\":\"UP\", \"kafka\":\"UP\"}}",
      "autoResize": false,
      "lineHeight": 1.25
    },
