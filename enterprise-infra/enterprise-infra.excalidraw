    },
    {
      "id": "NDckbhK-L2FeXepiglNQX",
      "type": "text",
      "x": 2075.5221558246185,
      "y": -242.5045327425549,
      "width": 462.61962890625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QKawASdCrt2O1Q1MviniL"
      ],
      "frameId": null,
      "index": "bFv",
      "roundness": null,
      "seed": 156786482,
      "version": 392,
      "versionNonce": 93818299,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402636,
      "link": null,
      "locked": false,
      "text": "Global Load Balancer (GLB) / WAF: We place an\nAWS CloudFront / Azure Front Door or\nCloudflare in front.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Global Load Balancer (GLB) / WAF: We place an AWS CloudFront / Azure Front Door or Cloudflare in front.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "HdmQqNt9cK-4F909M-bUq",
      "type": "text",
      "x": 2084.692199769931,
      "y": -147.5045327425549,
      "width": 444.279541015625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QKawASdCrt2O1Q1MviniL"
      ],
      "frameId": null,
      "index": "bFw",
      "roundness": null,
      "seed": 507897070,
      "version": 392,
      "versionNonce": 1807581045,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402636,
      "link": null,
      "locked": false,
      "text": "Function: Terminates SSL/mTLS (mutual\nTLS—the hospital EMR must present a client\ncertificate). Performs geo-routing (route US-\nclinical traffic to US-region K8s cluster) to\ncomply with data residency (HIPAA/GDPR).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Function: Terminates SSL/mTLS (mutual TLS—the hospital EMR must present a client certificate). Performs geo-routing (route US-clinical traffic to US-region K8s cluster) to comply with data residency (HIPAA/GDPR).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "FVzOhIdQd3mtc-n6P7dQj",
      "type": "text",
      "x": 2070.2821961078216,
      "y": 9.995467257445114,
      "width": 473.09954833984375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QKawASdCrt2O1Q1MviniL"
      ],
      "frameId": null,
      "index": "bFx",
      "roundness": null,
      "seed": 1026140402,
      "version": 392,
      "versionNonce": 1484004955,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919402636,
      "link": null,
      "locked": false,
      "text": "Observability Hook: Edge logs are\nlightweight—only Client_IP, Bytes_sent, and\nResponse_Status. If a single tenant floods the\nWAF with malformed requests, the WAF triggers\na \"Scrubbing Alert\" to the SOC (Security\nOperations Center) without waking the ML team.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Observability Hook: Edge logs are lightweight—only Client_IP, Bytes_sent, and Response_Status. If a single tenant floods the WAF with malformed requests, the WAF triggers a \"Scrubbing Alert\" to the SOC (Security Operations Center) without waking the ML team.",
      "autoResize": false,
      "lineHeight": 1.25
    },
