      "link": null,
      "locked": false,
      "text": "DDoS and SYN Flood Protection",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "-alwNTWfhov4hN8nCHDox",
      "originalText": "DDoS and SYN Flood Protection",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9H3pu4zaJ5FMKziAaVz0A",
      "type": "text",
      "x": -4796.327499317499,
      "y": 195.86064559958686,
      "width": 463.1595458984375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKi",
      "roundness": null,
      "seed": 555059950,
      "version": 351,
      "versionNonce": 1346873819,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "gETbwzaqW7NrkcfK4fBDU",
          "type": "arrow"
        }
      ],
      "updated": 1787919396018,
      "link": null,
      "locked": false,
      "text": "The GLB inspects the TCP handshake rate. If\nParis suddenly sends 10,000 requests/sec\n(malicious or broken EMR), the GLB's built-in\nWAF triggers a rate-limit at the edge, returning\n429 before waking up our API Gateway.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GLB inspects the TCP handshake rate. If Paris suddenly sends 10,000 requests/sec (malicious or broken EMR), the GLB's built-in WAF triggers a rate-limit at the edge, returning 429 before waking up our API Gateway.",
      "autoResize": false,
      "lineHeight": 1.25
    },
