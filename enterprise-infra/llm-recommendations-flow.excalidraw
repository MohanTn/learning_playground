      "type": "text",
      "x": -2545.4974096929873,
      "y": -3330.666545666092,
      "width": 717.5392456054688,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
