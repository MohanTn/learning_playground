      "updated": 1787919735969,
      "link": null,
      "locked": false,
      "text": "The Clinic creates a \"CSR\" (Certificate\nSigning Request): The admin bundles\ntheir Public Key together with their\nofficial business details (\"Clinic: Hamburg\nPractice, Location: Germany, Domain:\nemr.hamburg-practice.de\") and sends",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "nc62MG_DnvH1NuCRBUy8U",
      "originalText": "The Clinic creates a \"CSR\" (Certificate Signing Request): The admin bundles their Public Key together with their official business details (\"Clinic: Hamburg Practice, Location: Germany, Domain: emr.hamburg-practice.de\") and sends",
      "autoResize": true,
      "lineHeight": 1.25
    },
