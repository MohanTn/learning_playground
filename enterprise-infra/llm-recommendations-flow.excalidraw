    {
      "id": "PF8Kl04EenmAOaVkjyime",
      "type": "text",
      "x": 1393.691299259854,
      "y": -1338.7510535076967,
      "width": 798.4193115234375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLz",
      "roundness": null,
      "seed": 804424114,
      "version": 37,
      "versionNonce": 1262173813,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "-YVDJNRMmYXiRl0OOSVeZ",
          "type": "arrow"
        }
      ],
      "updated": 1787919735971,
      "link": null,
      "locked": false,
      "text": "The GLB does not just return a static 200 OK. It performs a deep health check\nto ensure the entire dependency chain is functional before telling the DNS it is\nhealthy.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GLB does not just return a static 200 OK. It performs a deep health check to ensure the entire dependency chain is functional before telling the DNS it is healthy.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "VubpMoZ5dbOfzuvEwojdi",
      "type": "text",
      "x": 1565.4411924483306,
      "y": -1193.7510535076967,
      "width": 454.9195251464844,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bM0",
      "roundness": null,
      "seed": 1704567406,
      "version": 36,
      "versionNonce": 133549915,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919735971,
      "link": null,
      "locked": false,
      "text": "The GLB's /actuator/health endpoint verifies:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GLB's /actuator/health endpoint verifies:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ykiAqSBPCYNpg_UYKjDQZ",
      "type": "text",
      "x": 1560.9711759688385,
      "y": -1123.7510535076967,
      "width": 463.85955810546875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bM1",
      "roundness": null,
      "seed": 337281906,
      "version": 36,
      "versionNonce": 1989519317,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919735971,
      "link": null,
      "locked": false,
      "text": "Its own process: Is the GLB software running?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Its own process: Is the GLB software running?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ICA1GYWW8jSDy71sfMirc",
      "type": "text",
      "x": 1422.161269962979,
      "y": -1066.2510535076967,
      "width": 741.4793701171875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bM2",
      "roundness": null,
      "seed": 861349038,
      "version": 36,
      "versionNonce": 618212347,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919735971,
      "link": null,
      "locked": false,
      "text": "Backend connectivity: Can the GLB reach the Internal API Gateway on the\nprivate subnet 10.0.20.x? (Ping or a minimal TCP handshake).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Backend connectivity: Can the GLB reach the Internal API Gateway on the private subnet 10.0.20.x? (Ping or a minimal TCP handshake).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "LJAIGqVUvrxmz0sPNwQpJ",
      "type": "text",
      "x": 1428.8012846114166,
      "y": -958.7510535076967,
      "width": 728.1993408203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bM3",
      "roundness": null,
      "seed": 748504370,
      "version": 36,
      "versionNonce": 295429429,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919735971,
      "link": null,
      "locked": false,
      "text": "Kafka/Persistence: (Optional) Can the GLB connect to the Kafka brokers?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kafka/Persistence: (Optional) Can the GLB connect to the Kafka brokers?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NXFwhAbqBFmeUQL3InY5F",
      "type": "text",
      "x": 1395.6813200118072,
      "y": -913.7510535076967,
      "width": 794.4392700195312,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bM4",
      "roundness": null,
      "seed": 1789550318,
      "version": 36,
      "versionNonce": 1382544539,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919735971,
      "link": null,
      "locked": false,
      "text": "TLS Certificate status: Is the GLB's X.509 certificate about to expire in the\nnext 7 days? (If yes, it returns a WARNING status, which the DNS can interpret\nas unhealthy if configured).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TLS Certificate status: Is the GLB's X.509 certificate about to expire in the next 7 days? (If yes, it returns a WARNING status, which the DNS can interpret as unhealthy if configured).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "3tB3_jnYr7aSKud8QynWY",
      "type": "text",
      "x": 1702.5110319258697,
      "y": -768.7510535076967,
