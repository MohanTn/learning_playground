      "boundElements": [],
      "updated": 1787920191856,
      "link": null,
      "locked": false,
      "text": "🔐 Both now have the exact same Shared Secret (2).<br/>MITM sees 8 and 19 but cannot\ncompute 2<br/>without solving Discrete Log (impossible for large primes).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "P_ORhcmwFEg4b_tA4g5in",
      "originalText": "🔐 Both now have the exact same Shared Secret (2).<br/>MITM sees 8 and 19 but cannot compute 2<br/>without solving Discrete Log (impossible for large primes).",
      "autoResize": true,
      "lineHeight": 1.25
    },
