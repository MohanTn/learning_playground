    {
      "id": "kmtzm-EUJT4WJjunsaQuJ",
      "type": "text",
      "x": -6440.865676488443,
      "y": 367.7246486721733,
      "width": 756.8709106445312,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
