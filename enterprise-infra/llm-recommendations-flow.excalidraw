      "lineHeight": 1.25
    },
    {
      "id": "E13SGcdkSD03hFTzpSycf",
      "type": "text",
      "x": 612.5757551493787,
      "y": 179.08414725280522,
      "width": 463.1595458984375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGN",
      "roundness": null,
      "seed": 1768646706,
      "version": 232,
      "versionNonce": 952894299,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "icrQmxx99JYGUJ9MWKCk8",
          "type": "arrow"
        }
      ],
      "updated": 1787919735969,
      "link": null,
      "locked": false,
      "text": "The GLB inspects the TCP handshake rate. If\nParis suddenly sends 10,000 requests/sec\n(malicious or broken EMR), the GLB's built-in\nWAF triggers a rate-limit at the edge, returning\n429 before waking up our API Gateway.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GLB inspects the TCP handshake rate. If Paris suddenly sends 10,000 requests/sec (malicious or broken EMR), the GLB's built-in WAF triggers a rate-limit at the edge, returning 429 before waking up our API Gateway.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "icrQmxx99JYGUJ9MWKCk8",
      "type": "arrow",
      "x": 452.23209671855193,
      "y": 297.6190957780706,
      "width": 154.84365843082674,
      "height": 56.13494852526537,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
