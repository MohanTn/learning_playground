    {
      "id": "RTvfqjuhbqhtgQn45GYUU",
      "type": "arrow",
      "x": -206.75080219088636,
      "y": 826.1287833575365,
      "width": 15.74746304772242,
      "height": 808.3868149635847,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
