      "versionNonce": 1605596821,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919735971,
      "link": null,
      "locked": false,
      "text": "Response Example:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Response Example:",
      "autoResize": true,
