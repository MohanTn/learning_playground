      "link": null,
      "locked": false,
      "text": "Computes Shared Secret:<br/>S =\nA^b mod p<br/>S = 8^15 mod 23\n= 2",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "kJuqqo-Gt2RnY6SuB2Ce3",
      "originalText": "Computes Shared Secret:<br/>S = A^b mod p<br/>S = 8^15 mod 23 = 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "P_ORhcmwFEg4b_tA4g5in",
