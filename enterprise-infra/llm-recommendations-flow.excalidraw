      "seed": 1944272434,
      "version": 81,
      "versionNonce": 206876987,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787919735969,
      "link": null,
      "locked": false,
      "text": "The CA validates and signs: The CA does background checks to ensure\nthe clinic really exists. Once verified, the CA takes their powerful Private\nKey and digitally \"stamps\" the clinic's Public Key and details.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Y8CerHE7CvyEprVZ9R48X",
      "originalText": "The CA validates and signs: The CA does background checks to ensure the clinic really exists. Once verified, the CA takes their powerful Private Key and digitally \"stamps\" the clinic's Public Key and details.",
      "autoResize": true,
      "lineHeight": 1.25
    },
