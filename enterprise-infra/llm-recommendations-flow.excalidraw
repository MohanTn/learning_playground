      "text": "Stripping External Layer",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "6Ro-20Pn350Rj-3wy74hJ",
      "originalText": "Stripping External Layer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "df8gYd3xlHKvHKiZdLCXE",
      "type": "text",
      "x": 6892.265076661594,
      "y": 439.03577532855564,
      "width": 436.1995849609375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMH",
      "roundness": null,
      "seed": 2118178094,
      "version": 532,
      "versionNonce": 1965632661,
      "isDeleted": true,
      "boundElements": [
        {
          "id": "iuRoYI8gSVQqyc8R0-0Fi",
          "type": "arrow"
        }
      ],
      "updated": 1787919735971,
      "link": null,
      "locked": false,
      "text": "The GLB removes the external client IP (to\nprevent exposing it to downstream logs) and\ninjects standard X-Forwarded-For and X-\nForwarded-Proto headers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The GLB removes the external client IP (to prevent exposing it to downstream logs) and injects standard X-Forwarded-For and X-Forwarded-Proto headers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
